<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/about"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="@drawable/link_bg"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:text="@string/about"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Button
            android:id="@+id/power"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/power_off"
            android:focusable="true"
            android:text="@string/connect"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/status_off"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/torStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/sub_off"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#E8EBEF"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/gear"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/gear_bg"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:padding="0dp"
        android:text="⚙"
        android:textColor="@color/muted"
        android:textSize="26sp" />
</FrameLayout>
