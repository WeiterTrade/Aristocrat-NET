<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/route_label"
                android:textColor="@color/gold" />

            <Spinner
                android:id="@+id/route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/route_names"
                android:focusable="true"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/heavyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/heavy_label"
                android:textColor="@color/gold" />

            <Spinner
                android:id="@+id/heavy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/heavy_names"
                android:focusable="true"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/bridgesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/bridges_label"
                android:textColor="@color/gold" />

            <Spinner
                android:id="@+id/bridges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/bridge_names"
                android:focusable="true"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/countryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/country_label"
                android:textColor="@color/gold" />

            <Spinner
                android:id="@+id/country"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/country_names"
                android:focusable="true"
                android:minHeight="48dp" />

            <LinearLayout
                android:id="@+id/customRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/customBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/link_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="4dp"
                    android:text="@string/custom_row"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/sendBridges"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_ghost"
                    android:contentDescription="@string/send_bridges"
                    android:focusable="true"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_send" />
            </LinearLayout>

            <TextView
                android:id="@+id/torLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/hint"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/apps_label"
                android:textColor="@color/gold" />

            <CheckBox
                android:id="@+id/keepLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:text="@string/keep_local"
                android:textColor="#FFFFFF" />

            <CheckBox
                android:id="@+id/geoTor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/geo_tor"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/appsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/apps_hint"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/apps"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/apps_button"
                    android:textAllCaps="false"
                    android:textColor="@color/gold_light"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/warpReset"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/warp_reset"
                    android:textAllCaps="false"
                    android:textColor="@color/gold_light"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/other_label"
                android:textColor="@color/gold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/openLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/link_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:text="@string/log_label_row"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
