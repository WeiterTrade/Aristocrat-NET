<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/custom_title"
        android:textColor="@color/gold_light"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/custom_info"
        android:textColor="@color/light"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/bridgesText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/card"
        android:gravity="top|start"
        android:hint="webtunnel [2001:db8::1]:443 … url=https://…"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="12sp"
        android:typeface="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/saveBridges"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_primary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/pasteBridges"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_ghost"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/paste"
            android:textAllCaps="false"
            android:textColor="@color/gold_light" />

        <Button
            android:id="@+id/clearBridges"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_ghost"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/clear"
            android:textAllCaps="false"
            android:textColor="@color/gold_light" />
    </LinearLayout>
</LinearLayout>
